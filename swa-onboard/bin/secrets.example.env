# Sample secrets file for swa-set-app-settings.sh.
#
# Copy to secrets.env (gitignored) and fill in real values, then run:
#   swa-set-app-settings.sh --config apps.json --secrets secrets.env
#
# Per-app token vars use the pattern BEACON_APP_TOKEN_<UPPER_SLUG>_(ID|SECRET)
# where <UPPER_SLUG> is the slug uppercased with `-` -> `_`.
# Add one pair per app listed in apps.json.

# --- Shared (applied to every SWA) ---
export AAD_CLIENT_ID=
export AAD_CLIENT_SECRET=

export BEACON_USER_TOKEN_ID=
export BEACON_USER_TOKEN_SECRET=

# GitHub Packages PAT (read:packages) — needed at deploy time so Oryx can
# install @1823-partners/swa-proxy.
export NODE_AUTH_TOKEN=

# --- Per-app Beacon tokens ---
# permissions
export BEACON_APP_TOKEN_PERMISSIONS_ID=
export BEACON_APP_TOKEN_PERMISSIONS_SECRET=

# browser
export BEACON_APP_TOKEN_BROWSER_ID=
export BEACON_APP_TOKEN_BROWSER_SECRET=

# secmaster
export BEACON_APP_TOKEN_SECMASTER_ID=
export BEACON_APP_TOKEN_SECMASTER_SECRET=

# otti
export BEACON_APP_TOKEN_OTTI_ID=
export BEACON_APP_TOKEN_OTTI_SECRET=

# bob-dashboard  (slug -> BOB_DASHBOARD)
export BEACON_APP_TOKEN_BOB_DASHBOARD_ID=
export BEACON_APP_TOKEN_BOB_DASHBOARD_SECRET=
